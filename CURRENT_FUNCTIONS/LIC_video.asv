function LIC_video(setup, endpoint, CameraNo)
% LIC_VIDEO - Function to create Line Integral Convolution visualization video
%   This function generates a video showing instantaneous flow using LIC technique
%
%   Usage: LIC_video(setup, endpoint, CameraNo)

if setup.pipeline.lic_video
    fprintf('Creating LIC video for base: %s at %s\n', setup.directory.base, datetime('now'));
    
    % Set up data location
    dataloc = fullfile(setup.directory.base, 'CalibratedPIV', num2str(setup.imProperties.imageCount), ...
                      ['Cam', num2str(CameraNo)], 'Instantaneous', endpoint);
    
    % Set up output directory
    output_dir = fullfile(setup.directory.base, 'Videos', num2str(setup.imProperties.imageCount), ...
                         ['Cam', num2str(CameraNo)], 'LIC_Analysis');
    if ~exist(output_dir, 'dir')
        mkdir(output_dir);
    end
    
    for i = setup.instantaneous.runs
        fprintf('Processing run %d for LIC video...\n', i);
        
        % Load coordinates
        Co_ords = load(fullfile(dataloc, 'Co_ords.mat'));
        x = Co_ords.Co_ords(i).x;
        y = Co_ords.Co_ords(i).y;
        
        % Load first image to get mask and determine cropping parameters
        VelData = load(fullfile(dataloc, sprintf('%05d.mat', 1)));
        b_mask = VelData.piv_result(i).b_mask;
        
        % Calculate cropping parameters for largest central square
        [rows, cols] = size(x);
        square_size = min(rows, cols);
        
        % Calculate centered crop indices
        row_center = floor(rows / 2);
        col_center = floor(cols / 2);
        half_square = floor(square_size / 2);
        
        crop_row_start = row_center - half_square + 1;
        crop_row_end = crop_row_start + square_size - 1;
        crop_col_start = col_center - half_square + 1;
        crop_col_end = crop_col_start + square_size - 1;
        
        fprintf('Cropping parameters: rows %d:%d, cols %d:%d\n', ...
                crop_row_start, crop_row_end, crop_col_start, crop_col_end);
        
        % Video setup
        video_filename = fullfile(output_dir, sprintf('LIC_Video_Run%d_%dx%d.mp4', ...
                                 i, setup.instantaneous.windowSize(i,1), setup.instantaneous.windowSize(i,2)));
        v = VideoWriter(video_filename, 'MPEG-4');
        v.FrameRate = 30; % Adjust as needed
        open(v);
        
        % LIC options
        options.spot_size = 2;
        options.flow_correction = 1;
        lic_length = 12; % Adjust as needed
        upsample_factor = 5; % Adjust as needed
        
        % Process each frame
        for imNo = 1:setup.imProperties.imageCount
            % Load velocity data
            VelData = load(fullfile(dataloc, sprintf('%05d.mat', imNo)));
            u = VelData.piv_result(i).ux;
            v_vel = VelData.piv_result(i).uy;
            
            % Apply spatial smoothing
            sigma = 1;
            u_smooth = imgaussfilt(u, sigma, 'FilterDomain', 'spatial');
            v_smooth = imgaussfilt(v_vel, sigma, 'FilterDomain', 'spatial');
            
            % Crop to square region
            u_cropped = u_smooth(crop_row_start:crop_row_end, crop_col_start:crop_col_end);
            v_cropped = v_smooth(crop_row_start:crop_row_end, crop_col_start:crop_col_end);
            x_cropped = x(crop_row_start:crop_row_end, crop_col_start:crop_col_end);
            y_cropped = y(crop_row_start:crop_row_end, crop_col_start:crop_col_end);
            b_mask_cropped = b_mask(crop_row_start:crop_row_end, crop_col_start:crop_col_end);
            
            % Get coordinate corners for cropped region
            xcorners_cropped = [min(x_cropped(:)), max(x_cropped(:))];
            ycorners_cropped = [min(y_cropped(:)), max(y_cropped(:))];
            
            % Upsample for better LIC quality
            upsampled_u = imresize(u_cropped, upsample_factor, 'bicubic');
            upsampled_v = imresize(v_cropped, upsample_factor, 'bicubic');
            upsampled_b_mask = imresize(b_mask_cropped, upsample_factor, 'nearest');
            
            % Prepare vector field for LIC (note the negative sign for v component)
            upsample_cat_v = cat(3, -upsampled_v, upsampled_u);
            upsample_cat_v = perform_vf_normalization(upsample_cat_v);
            
            % Generate LIC
            lic = perform_lic(upsample_cat_v, lic_length, options);
            
            % Apply mask to LIC
            lic(upsampled_b_mask == 1) = 0;
            
            % Create figure
            fig = figure('Visible', 'off');
            set(fig, 'Units', 'Normalized', 'OuterPosition', [0, 0.04, 1, 0.96]);
            
            % Create LIC visualization
            ax = axes;
            A = imagesc(xcorners_cropped, ycorners_cropped, lic);
            colormap(ax, gray);
            daspect(ax, [1 1 1]);
            
            % Set transparency for LIC (show only non-masked areas)
            alphaData_lic = lic ~= 0;
            set(A, 'AlphaData', alphaData_lic);
            set(gca, 'YDir', 'normal', 'FontSize', setup.figures.axisFontSize, ...
                    'LineWidth', 1.5, 'TickLabelInterpreter', 'latex');
            
            % Set axis limits and labels
            xlim(xcorners_cropped);
            ylim(ycorners_cropped);
            
            % Add title and labels
            title('Instantaneous Line Integral Convolution', ...
                  'Interpreter', 'latex', 'FontSize', setup.figures.titleFontSize);
            xlabel('x [mm]', 'Interpreter', 'latex', 'FontSize', setup.figures.labelFontSize);
            ylabel('y [mm]', 'Interpreter', 'latex', 'FontSize', setup.figures.labelFontSize);
            
            % Capture frame
            frame = getframe(fig);
            writeVideo(v, frame);
            
            % Close figure
            close(fig);
            
            % Progress indicator
            if mod(imNo, 10) == 0
                fprintf('Processed frame %d/%d\n', imNo, setup.imProperties.imageCount);
            end
        end
        
        % Close video
        close(v);
        fprintf('Video saved: %s\n', video_filename);
        
        % Create a sample frame for reference
        sample_frame_dir = fullfile(output_dir, 'Sample_Frames');
        if ~exist(sample_frame_dir, 'dir')
            mkdir(sample_frame_dir);
        end
        
        % Generate sample frame from middle of sequence
        mid_frame = round(setup.imProperties.imageCount / 2);
        VelData = load(fullfile(dataloc, sprintf('%05d.mat', mid_frame)));
        u = VelData.piv_result(i).ux;
        v_vel = VelData.piv_result(i).uy;
        
        % Process sample frame
        sigma = 1;
        u_smooth = imgaussfilt(u, sigma, 'FilterDomain', 'spatial');
        v_smooth = imgaussfilt(v_vel, sigma, 'FilterDomain', 'spatial');
        
        % Crop and process sample frame
        u_cropped = u_smooth(crop_row_start:crop_row_end, crop_col_start:crop_col_end);
        v_cropped = v_smooth(crop_row_start:crop_row_end, crop_col_start:crop_col_end);
        x_cropped = x(crop_row_start:crop_row_end, crop_col_start:crop_col_end);
        y_cropped = y(crop_row_start:crop_row_end, crop_col_start:crop_col_end);
        b_mask_cropped = b_mask(crop_row_start:crop_row_end, crop_col_start:crop_col_end);
        
        xcorners_cropped = [x_cropped(1,1), x_cropped(1,end)];
        ycorners_cropped = [y_cropped(1,1), y_cropped(end,end)];
        
        % Generate LIC for sample
        upsampled_u = imresize(u_cropped, upsample_factor, 'bicubic');
        upsampled_v = imresize(v_cropped, upsample_factor, 'bicubic');
        upsampled_b_mask = imresize(b_mask_cropped, upsample_factor, 'nearest');
        
        upsample_cat_v = cat(3, -upsampled_v, upsampled_u);
        upsample_cat_v = perform_vf_normalization(upsample_cat_v);
        
        lic = perform_lic(upsample_cat_v, lic_length, options);
        lic(upsampled_b_mask == 1) = 0;
        
        % Create and save sample frame
        fig = figure('Visible', 'off');
        set(fig, 'Units', 'Normalized', 'OuterPosition', [0, 0.04, 1, 0.96]);
        
        ax = axes;
        A = imagesc(xcorners_cropped, ycorners_cropped, lic);
        colormap(ax, gray);
        daspect(ax, [1 1 1]);
        alphaData_lic = lic ~= 0;
        set(A, 'AlphaData', alphaData_lic);
        set(gca, 'YDir', 'normal', 'FontSize', setup.figures.axisFontSize, ...
                'LineWidth', 1.5, 'TickLabelInterpreter', 'latex');
        
        xlim(xcorners_cropped);
        ylim(ycorners_cropped);
        
        title(sprintf('Sample Frame: Line Integral Convolution\\nFrame %d, Run %d', ...
                     mid_frame, i), ...
              'Interpreter', 'latex', 'FontSize', setup.figures.titleFontSize);
        xlabel('x [mm]', 'Interpreter', 'latex', 'FontSize', setup.figures.labelFontSize);
        ylabel('y [mm]', 'Interpreter', 'latex', 'FontSize', setup.figures.labelFontSize);
        
        % Save sample frame
        sample_base = sprintf('SampleFrame_LIC_Run%d_%dx%d', i, setup.instantaneous.windowSize(i,1), setup.instantaneous.windowSize(i,2));
        saveas(fig, fullfile(sample_frame_dir, [sample_base, '.fig']));
        saveas(fig, fullfile(sample_frame_dir, [sample_base, '.png']));
        saveas(fig, fullfile(sample_frame_dir, [sample_base, '.eps']));
        close(fig);
    end
    
    fprintf('LIC video generation completed at %s\n', datetime('now'));
end

end
